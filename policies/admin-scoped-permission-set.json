{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "allowAdminS3UsWest2",
            "Effect": "Allow",
            "Action": [
                "s3:*"
            ],
            "Resource": [
                "*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "us-west-2"
                }
            }
        }
    ]
}
